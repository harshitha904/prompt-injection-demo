# Copy this file to .env and fill in what you need.
# Ollama needs no key. Only add a key for the cloud models you want to use.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model names change over time. Remove the # and set a current name if you get "model not found".
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-haiku-5-5

# Where Ollama is running (default shown).
# OLLAMA_URL=http://127.0.0.1:11434

# Model selected when the page opens: gemini, anthropic, or ollama:<name> (e.g. ollama:llama3.2:1b).
# DEFAULT_ENGINE=

# 0 = the same prompt gives the same reply every time (best for a rehearsed demo).
# TEMPERATURE=0

# Change if port 3000 is already in use.
# PORT=3000
